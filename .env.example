# ====================================================================
# Lovelle - Environment Variables Configuration
# Copy this file to .env.local for local development
# ====================================================================

# Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase PostgreSQL Database & Auth ─────────────────────────────
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key # Keep server-side only!

# ── Analytics (Optional / Future Growth) ───────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog Product Telemetry
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Admin Route Protection ─────────────────────────────────────────
# Secret key required to access /admin/analytics
ADMIN_SECRET_KEY=lovelle_admin_secret_demo

# ── Google AdSense (Monetization Readiness) ─────────────────────────
# Required once publisher account is approved (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
